import json, pathlib
R=pathlib.Path('episodes/EP007'); S=R/'script'; B=R/'storyboard'; S.mkdir(exist_ok=True); B.mkdir(exist_ok=True)
P=[]
def add(p,desc,note,voice='',camera='중경',palette='청회색·신호 빨강',typ='normal'):
    i=1+sum(x['page']==p for x in P); P.append(dict(id=f'p{p}-{i}',page=p,scene=p,desc=desc,note=note,voice=voice,camera=camera,palette=palette,type=typ))
add(1,'EP006 노트의 빈 제출처가 적힌 봉투가 PDC 회의장 중앙에 놓이고, 뒤의 여섯 관제 화면은 검은 천으로 가려져 있다.','봉투는 작고 천 그림자는 크게. 왕머여의 청회색 셔츠와 뿔테, 스치친의 올리브 재킷은 가장자리의 작은 실루엣. 무대사·무자막.','', '풀페이지 광각·낮은 시점','청회색·검정','silence')
add(2,'검증위원의 손이 봉투를 연다. 노트 첫 줄과 여섯 지문 그림만 보인다.','종이 가장자리에 왕머여 손의 눌린 자국. 글자 자리는 비운다.','','손 인서트','흰색·청회색')
add(2,'검증위원이 보고서 위에 오염 표시 도장을 내려놓는다.','위원의 얼굴보다 도장의 짙은 그림자를 크게.','검증위원: 오염된 데이터로 무슨 물리학을 합니까.','도장 극근접','검정·신호 빨강','impact')
add(2,'왕머여가 뿔테를 고쳐 쓰며 반박하려다 입을 다문다.','눈썹이 좁혀지고 입술이 한 번 열렸다 닫힌다.','','얼굴 클로즈업','청회색·흰색','silence')
add(2,'스치친이 손가락의 꺼진 담배를 돌리고 여섯 가린 화면을 본다.','헝클어진 검은 머리, 수염, 좁은 피곤한 눈. 농담처럼 말하지만 시선은 도장에 고정.','스치친: 거짓말도 입을 맞추려면 시간이 걸려.','측면 이인물','올리브·검정')
add(3,'왕머여가 위조 출력 그래프를 뒤집어 뒷면의 빈 시간축을 드러낸다.','반박을 삼키고 손목을 단단히 편다.','왕머여: 그 값은 믿지 않습니다.','탁상 탑숏','흰색·청색')
add(3,'파란 입력선과 빨간 출력선이 분리된 투명 슬라이드를 겹치지 않고 나란히 놓는다.','두 선 사이에 시간 여백을 분명히 둔다.','','도표 인서트','청색·신호 빨강')
add(3,'왕머여가 출력선이 바뀌는 지점을 손끝으로 가리킨다.','큰 렌즈 반사 아래 눈의 초점이 선 끝에 고정된다.','왕머여: 바뀌는 순서를 보자는 겁니다.','오버숄더 클로즈업','흰색·청색','impact')
add(3,'검증위원이 빈 실패 기준 칸을 가리키며 펜을 건넨다.','표정은 냉정하되 악역처럼 과장하지 않는다.','검증위원: 먼저 틀릴 조건부터 쓰십시오.','중경 정면','청회색·검정')
add(4,'왕머여 펜끝이 실패 기준 칸 위에서 멈춘다.','엄지 마디가 하얗게 눌린다.','','펜 극근접','흰색·검정','silence')
add(4,'무교란 대조군의 평평한 파란 선과 교란군의 빈 칸을 나란히 그린다.','글자와 숫자는 비워 두고 선의 역할만 명확히 한다.','왕머여: 대조군도 따라 움직이면, 제 보고서는 찢으십시오.','노트 탑숏','청색·흰색')
add(4,'스치친이 노트 아래에 복사용 종이를 한 장 더 밀어 넣는다.','거친 손이 종이 모서리를 정교하게 맞춘다.','스치친: 찢기 전에 사본은 남깁시다.','손 클로즈업','호박색·흰색')
add(5,'왕머여가 같은 톱니 카드 여섯 장을 펼친다.','규칙적 배열이 너무 깔끔해 보이게 한다.','','탁상 광각','흰색·신호 빨강')
add(5,'스치친이 카드 한 장을 빼고 신발 자국처럼 비스듬히 돌린다.','낡은 재킷 소매가 카드 위를 스친다.','스치친: 도둑 잡는데 같은 신발 여섯 켤레를 깔아두진 않아.','손 낮은 앵글','올리브·흰색')
add(5,'여섯 카드가 삼각·계단·갈고리·갈라진 선·짧은 점·톱니로 달라진다.','문자 없는 도형으로 한눈에 구분. 카드 간 거리를 일정하게.','','탑숏 매크로','신호 빨강·청색','impact')
add(5,'왕머여가 카드 뒤에 서로 다른 시각표를 놓는다.','가늘고 마른 손이 급하게 움직이다 마지막 카드에서 멈춘다. 정확한 시각은 후처리.','왕머여: 모양도, 시각도 나눕니다.','오버숄더','흰색·청회색')
add(6,'서로 다른 시설의 시계를 병렬로 맞추는 연구원 손들이 영상 창에 보인다.','시계 숫자는 비워 두고 초침 각도만 비교 가능하게.','','분할 화면','청색·흰색')
add(6,'왕머여가 한 장비의 교란 스위치에 투명 덮개를 씌운다.','대조군의 덮개만 봉인 띠가 온전하다.','왕머여: 대조 장비엔 손대지 마세요.','스위치 인서트','청색·검정')
add(6,'스치친이 입력 카드 봉투를 봉인하고 자신의 손도 화면 밖으로 뺀다.','수염 밑 입꼬리는 얇고 눈은 진지하다.','스치친: 이쪽 봉투는 내 손이 더러워도 안 열지.','손·얼굴 중경','올리브·호박색')
add(6,'검증위원이 각 봉투와 대조군을 확인하고 서명 칸에 펜을 댄다.','서명 글자는 후처리, 펜의 접촉 순간만 보여 준다.','','사선 오버숄더','청회색·흰색','impact')
add(7,'검증위원이 한 손가락을 들어 단 한 차례 시험을 허락한다.','손가락 뒤 여섯 화면의 검은 천이 벗겨지기 시작한다.','검증위원: 한 번입니다.','낮은 앵글 중경','검정·청색')
add(7,'왕머여가 여섯 입력 키의 서로 다른 모양을 확인한다.','안경의 흰 반사가 여섯 칸으로 쪼개진다.','왕머여: 한 번이면 순서는 볼 수 있습니다.','렌즈 클로즈업','흰색·청색')
add(7,'여섯 손가락이 시설마다 다른 키 위에서 동시에 멈춘다.','누르기 직전의 손톱과 굳은 관절에 긴장.','','분할 화면 탑숏','청색·호박색','silence')
add(7,'첫 키가 눌리고 파란 입력선 하나가 꺾인다. 빨간 출력선은 아직 그대로다.','파란 변화가 빨간 선보다 먼저임을 분명히 한다.','','선·손 극근접','청색·신호 빨강','impact')
add(8,'텅 빈 관제실의 여섯 모니터에 가느다란 정지선. 아래 구석의 왕머여와 스치친은 아주 작고 움직이지 않는다.','무대사·무자막 풀페이지. 큰 빈 벽과 검은 그림자. 기다림 자체를 긴 시간으로 만든다.','','풀페이지 먼 광각','청회색·검정','silence')
add(9,'한 시설의 빨간 출력선에 교란의 작은 흔들림이 나타난다.','왕머여 손이 의자 팔걸이를 세게 쥔다.','','화면·손 교차','신호 빨강·청색')
add(9,'빨간 선의 흔들림이 급속히 줄어 매끈한 선으로 돌아간다.','선이 얇아지는 과정 세 단계만 보여 시간 압축.','검증위원: 돌아왔군요. 원래대로.','그래프 극근접','신호 빨강·흰색','impact')
add(9,'왕머여가 다른 화면으로 눈을 옮긴다. 각 화면의 복구 시작점이 미세하게 다르다.','실망으로 내려간 눈꼬리가 다시 초점을 찾는다.','왕머여: 너무 빨리요.','눈·화면 교차 클로즈업','청회색·신호 빨강')
add(10,'왕머여가 여섯 화면의 복구 구간을 투명 종이 띠로 뜯어 나란히 펼친다.','손이 떨리지만 띠의 시작점은 정확히 맞춘다.','','탁상 광각','흰색·청색')
add(10,'계단 입력 뒤엔 계단 모양 보정, 갈고리 뒤엔 갈고리 모양 보정이 서로 다른 시차로 나타난다.','파랑 입력과 빨강 후행 반응을 시각적으로 분리. 시간 수치는 후처리.','왕머여: 계단은 계단 뒤에, 갈고리는 갈고리 뒤에 바뀌었습니다.','도표 매크로','청색·신호 빨강','impact')
add(10,'다른 네 지문도 각각 자기 모양을 따라가며 붉은 출력 폭이 좁아진다.','여섯 짝의 방향만 보이게 과잉 장식을 없앤다.','','분할 화면 정면','신호 빨강·흰색','impact')
add(10,'스치친이 사용한 카드와 복구 띠를 겹치지 않고 나란히 둔다.','피곤한 좁은 눈이 그 차이를 읽고, 담배 든 손은 멈춘다.','스치친: 발자국을 지우면서 새 발자국을 찍었네.','이인물 중경','올리브·청회색')
add(11,'검증위원이 여섯 화면 뒤에 공통 장비 계통도를 세운다.','한 가지 의심이 방 전체를 다시 덮는 검은 그림자.','검증위원: 같은 계통의 장비라면?','낮은 앵글 광각','검정·청색')
add(11,'왕머여가 쓰려던 결론의 첫 줄을 펜으로 가로 긋는다.','입을 굳게 다물고, 빨간 선의 반사에서 눈을 떼어낸다.','','노트·얼굴 클로즈업','흰색·검정','silence')
add(11,'스치친이 봉인된 무교란 대조 봉투를 위원 앞에 놓는다.','봉인선이 끊어지지 않았음을 크게.','왕머여: 그래서 손대지 않은 선이 있습니다.','봉투 인서트','올리브·흰색')
add(11,'세 사람이 봉투를 내려다보며 누구도 먼저 손대지 않는다.','위원의 손, 왕머여의 마른 손, 스치친의 거친 손을 삼각형으로.','','탑숏 중경','청회색·호박색','silence')
add(12,'검증위원이 봉인을 열고 대조군의 평평한 선을 여섯 변화 옆에 놓는다.','봉투가 찢어지면서도 기록선은 흔들리지 않는다.','','도표 탑숏','흰색·청색','impact')
add(12,'왕머여가 각 시설의 입력 시각과 출력 변화 시각을 서로 다른 투명자로 잰다.','입력 이전 구간은 빈 여백; 뒤쪽만 붉은 결이 있다.','왕머여: 입력 전엔 없고, 대조에는 없습니다.','손·그래프 매크로','청색·신호 빨강')
add(12,'검증위원이 대조선과 오염 출력선을 번갈아 본다.','눈썹은 풀리지 않지만 도장은 더 이상 보고서 위에 있지 않다.','검증위원: 그럼 이건 물리학의 값이 아니군요.','얼굴·도표 중경','청회색·흰색')
add(13,'여섯 모니터의 서로 다른 빨간 지문이 각기 다른 박자로 교란 뒤를 따라 좁아진다. 평평한 파란 대조선은 중앙을 가른다.','무대사·무자막 풀페이지. 파형들이 하나의 거대한 악보처럼 수렴하되 완전한 눈이나 지능의 얼굴로 단정하지 않는다.','','풀페이지 정면 광각','청색·신호 빨강·검정','silence')
add(14,'왕머여가 위원의 물음 앞에 펼친 손을 책상에 얹는다.','승리 포즈 대신 손바닥을 평평하게.','왕머여: 거짓말의 반응 시간입니다.','이인물 중경','청회색·흰색')
add(14,'검증위원이 보고서의 승인 칸을 비워 두고 다음 시험 칸을 가리킨다.','표정의 경계는 유지, 도장 손은 내린다.','검증위원: 한 번으로는 결재할 수 없습니다.','문서·손 오버숄더','흰색·검정')
add(14,'스치친이 두 번째 빈 봉투를 꺼내 왕머여 옆에 놓는다.','좁은 눈에 웃음기가 돌아오지만 몸은 화면을 향한다.','스치친: 그럼 두 번째 신발을 놓죠.','측면 중경','올리브·호박색')
add(14,'왕머여가 보고서에 제한된 한 줄을 쓰고 아래를 길게 비운다.','청회색 셔츠 소매를 걷은 손은 흔들리지 않는다. 문장 전체는 후처리.','왕머여: 감시자는 입력마다 보정했습니다. 내부는 아직 모릅니다.','노트 탑숏','흰색·청색','impact')
add(15,'p1에서 가려졌던 여섯 화면이 열린다. 각기 다른 지문과 후행 보정선이 배열돼 멀리서 하나의 눈 윤곽처럼 보인다. 왕머여와 스치친은 그 앞의 작은 뒷모습.','무대사·무자막 풀페이지. 실제 눈이나 소페르 본체는 그리지 않는다. 관측하는 자와 관측당하는 자의 위치가 겹치는 불안한 종결.','','풀페이지 후면 초광각','청회색·신호 빨강·검정','silence')
assert len(P)==45, len(P)
counts=[sum(x['page']==p for x in P) for p in range(1,16)]
assert counts==[1,4,4,3,4,4,4,1,3,4,4,3,1,4,1],counts
md=['# EP007 패널 대본 — S2E02 「적의 실험 장치」','','15페이지·45컷. p1·p8·p13·p15 무대사·무자막 풀페이지. "'`왕머여`는 EP006 `왕먀오`와 같은 인물. 한글·숫자·도표 라벨은 이미지에 그리지 않고 후처리.'"','','**STYLE_BLOCK (향후 모든 이미지 생성 프롬프트 맨 앞):** Bold clean ink linework, flat vibrant cell-shaded colors, rounded expressive character designs, dramatic but playful composition, distinctive 1980s Akira Toriyama manga aesthetic. Simple but expressive backgrounds with bold black shadows. Clean panel borders, dynamic perspective.','']
