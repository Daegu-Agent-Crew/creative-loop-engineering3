          "type": "string"
        }
      }
    },
    "cold_open": {
      "type": "string"
    },
    "concept_seeding": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "silence_pages": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "applied_principles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(TB|HM)-[0-9]{2}$"
      }
    },
