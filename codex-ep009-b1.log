const jobs=JSON.parse(fs.readFileSync(jpath,'utf8'));
const ids=new Set(['p1-1','p2-1','p2-2','p2-3','p2-4']);
const canon=['episodes/EP006/panels/assets/p2-1.png','episodes/EP006/panels/assets/p3-1.png'];
const now=new Date().toISOString();
for(const p of panels.panels){
  if("'!ids.has(p.panel_id)) continue;
  const size=fs.statSync(p.image_path).size;
  if(size<=300*1024) throw new Error(`${p.panel_id}: ${size} bytes`);
  p.generation_status='"'generated';
  p.attempt_count=p.panel_id==='p2-2'?2:1;
  p.worker_tier='low_performance';
  p.image_model='gpt-image-2';
  p.completed_at=now;
  p.qa_score=null;
  p.ai_score=null;
  p.last_error=null;
  if(p.page_number===2) p.reference_assets=[...new Set([...p.reference_assets,...canon])];
}
for(const j of jobs.jobs){
  if(j.page_number"'!==1 && j.page_number!==2) continue;
  j.status='"'completed';
  j.completed_at=now;
  j.last_error=null;
  j.qa_score=null;
  if(j.page_number===2) j.references_used=[...new Set([...j.references_used,...canon])];
}
