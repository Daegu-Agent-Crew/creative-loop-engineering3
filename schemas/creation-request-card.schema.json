{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLE3 Creation Request Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "panel_id", "bible", "dna", "state", "delta", "camera", "narrative_function", "references", "output_rules", "compiled_prompt"],
  "properties": {
    "schema_version": { "const": 1 },
    "episode_id": { "type": "string", "pattern": "^EP[0-9]{3}$" },
    "panel_id": { "type": "string", "pattern": "^p[0-9]+-[0-9]+$" },
    "bible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "const": "approved" }
      }
    },
    "dna": {
      "type": "object",
      "required": ["visual_style", "characters", "locations", "props", "world_rules", "prohibited_changes"],
      "properties": {
        "visual_style": { "type": "array", "items": { "type": "string" } },
        "characters": { "type": "array", "items": { "type": "object" } },
        "locations": { "type": "array", "items": { "type": "object" } },
        "props": { "type": "array", "items": { "type": "object" } },
        "world_rules": { "type": "array", "items": { "type": "string" } },
        "prohibited_changes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "state": { "type": "array", "items": { "type": "string" } },
    "delta": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "camera": { "type": "string", "minLength": 1 },
    "narrative_function": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_path", "source", "anchor_id"],
        "properties": {
          "asset_path": { "type": "string", "minLength": 1 },
          "source": { "const": "approved_bible" },
          "anchor_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "output_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "compiled_prompt": { "type": "string", "minLength": 1 }
  }
}
