{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLE3 Serialized Creation Bible",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "episode_id", "version", "status", "visual_style", "world_rules", "characters", "locations", "props", "continuity_rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "episode_id": { "type": "string", "pattern": "^EP[0-9]{3}$" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["provisional", "approved", "retired"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "approval_evidence": { "type": ["string", "null"] },
    "visual_style": { "$ref": "#/definitions/visualStyle" },
    "world_rules": { "type": "array", "items": { "$ref": "#/definitions/worldRule" } },
    "characters": { "type": "array", "items": { "$ref": "#/definitions/character" } },
    "locations": { "type": "array", "items": { "$ref": "#/definitions/location" } },
    "props": { "type": "array", "items": { "$ref": "#/definitions/prop" } },
    "continuity_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "definitions": {
    "status": { "type": "string", "enum": ["provisional", "approved", "retired"] },
    "visualStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "immutable_traits", "palette", "rendering_rules", "evidence_paths"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "immutable_traits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "palette": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rendering_rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "worldRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "immutable_facts", "prohibited_changes", "panel_ids", "evidence_paths"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "immutable_facts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "prohibited_changes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "panel_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^p[0-9]+-[0-9]+$" } },
        "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "visual_cues"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "visual_cues": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_panel_ids": { "type": "array", "items": { "type": "string", "pattern": "^p[0-9]+-[0-9]+$" } }
      }
    },
    "outfit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "immutable_traits"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "immutable_traits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_panel_ids": { "type": "array", "items": { "type": "string", "pattern": "^p[0-9]+-[0-9]+$" } }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "reference_asset", "immutable_traits", "outfits", "expressions", "evidence_paths"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "reference_asset": { "type": "string", "minLength": 1 },
        "immutable_traits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outfits": { "type": "array", "items": { "$ref": "#/definitions/outfit" } },
        "expressions": { "type": "array", "items": { "$ref": "#/definitions/expression" } },
        "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "era", "anchor_asset", "immutable_traits", "lighting_states", "panel_ids", "evidence_paths"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "era": { "type": "string", "minLength": 1 },
        "anchor_asset": { "type": "string", "minLength": 1 },
        "immutable_traits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "lighting_states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "panel_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^p[0-9]+-[0-9]+$" } },
        "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "anchor_asset", "immutable_traits", "narrative_function", "panel_ids", "evidence_paths"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "anchor_asset": { "type": "string", "minLength": 1 },
        "immutable_traits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "narrative_function": { "type": "string", "minLength": 1 },
        "panel_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^p[0-9]+-[0-9]+$" } },
        "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
