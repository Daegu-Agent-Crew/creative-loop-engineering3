{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLE3 Panel Convergence Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "panel_id", "status", "iterations", "selection"],
  "properties": {
    "schema_version": { "const": 1 },
    "episode_id": { "type": "string", "pattern": "^EP[0-9]{3}$" },
    "panel_id": { "type": "string", "pattern": "^p[0-9]+-[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["planned", "generating", "evaluating", "selected", "approved", "failed"]
    },
    "baseline_image_path": { "type": ["string", "null"] },
    "reference_assets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "iterations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/iteration" }
    },
    "selection": { "$ref": "#/definitions/selection" }
  },
  "definitions": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_consistency", "storyboard_fidelity", "composition", "style_consistency", "scene_continuity", "total"],
      "properties": {
        "character_consistency": { "type": "number", "minimum": 0, "maximum": 10 },
        "storyboard_fidelity": { "type": "number", "minimum": 0, "maximum": 10 },
        "composition": { "type": "number", "minimum": 0, "maximum": 10 },
        "style_consistency": { "type": "number", "minimum": 0, "maximum": 10 },
        "scene_continuity": { "type": "number", "minimum": 0, "maximum": 10 },
        "total": { "type": "number", "minimum": 0, "maximum": 50 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "variant", "prompt", "output_path", "reference_assets", "status"],
      "properties": {
        "candidate_id": { "type": "string" },
        "variant": { "type": "integer", "minimum": 1, "maximum": 3 },
        "prompt": { "type": "string", "minLength": 1 },
        "output_path": { "type": "string", "pattern": "^\\.candidates/" },
        "reference_assets": { "type": "array", "items": { "type": "string" } },
        "status": {
          "type": "string",
          "enum": ["pending", "generated", "evaluated", "selected", "rejected", "failed"]
        },
        "scores": { "$ref": "#/definitions/scores" },
        "diagnosis": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_order", "verdict", "winner_candidate_id", "reason", "next_prompt_adjustment"],
      "properties": {
        "candidate_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "verdict": { "type": "string", "enum": ["winner", "tie", "both_bad"] },
        "winner_candidate_id": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "next_prompt_adjustment": { "type": ["string", "null"] },
        "evaluator": { "type": "string" },
        "evaluated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "candidates", "comparison"],
      "properties": {
        "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/candidate" }
        },
        "comparison": { "anyOf": [{ "$ref": "#/definitions/comparison" }, { "type": "null" }] }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "promoted_path", "reason", "human_approved"],
      "properties": {
        "candidate_id": { "type": ["string", "null"] },
        "promoted_path": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "human_approved": { "type": "boolean" },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
