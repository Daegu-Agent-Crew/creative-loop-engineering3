{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLE3 Decision Waiting Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": { "const": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "episode_id", "kind", "owner", "request", "status", "waiting_since", "waiting_since_basis", "due_at", "overdue_action", "source_path", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "episode_id": { "type": "string", "pattern": "^EP\\d{3}$" },
          "kind": { "enum": ["merge", "gate", "rebaseline", "candidate"] },
          "owner": { "type": "string", "minLength": 1 },
          "request": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "resolved"] },
          "waiting_since": { "type": "string", "format": "date-time" },
          "waiting_since_basis": { "enum": ["tracking_started", "pull_request_created", "human_request"] },
          "due_at": { "type": "string", "format": "date-time" },
          "overdue_action": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "pr_number": { "type": "integer", "minimum": 1 },
          "gate_id": { "enum": ["story-lock", "character-lock", "storyboard-lock", "release"] },
          "prerequisite": { "const": "phase5_completed" },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decided_by", "decided_at", "decision", "evidence"],
            "properties": {
              "decided_by": { "type": "string", "minLength": 1 },
              "decided_at": { "type": "string", "format": "date-time" },
              "decision": { "type": "string", "minLength": 1 },
              "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
