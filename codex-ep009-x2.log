changed=[]
for panel in data['panels']:
    if panel['panel_id'] in ids:
        asset=Path(panel['image_path'])
        if asset.exists() and asset.stat().st_size>300*1024:
            panel['generation_status']='generated'
            changed.append(panel['panel_id'])
fd,tmp=tempfile.mkstemp(dir=path.parent,prefix='.panels-',suffix='.json')
with os.fdopen(fd,'w') as f: json.dump(data,f,ensure_ascii=False,indent=2); f.write('\\n')
os.replace(tmp,path)
counts={}
for p in data['panels']: counts[p['generation_status']]=counts.get(p['generation_status'],0)+1
manifest=root/'MANIFEST.md'
text=manifest.read_text()
import re
text=re.sub(r'- generated_panels: \\d+',f'- generated_panels: {counts.get(\"generated\",0)+counts.get(\"approved\",0)}',text)
text=re.sub(r'- pending_panels: \\d+',f'- pending_panels: {counts.get(\"pending\",0)}',text)
