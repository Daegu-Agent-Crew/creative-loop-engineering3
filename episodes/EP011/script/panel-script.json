{
  "episode_id": "EP011",
  "version": 1,
  "source": "episodes/EP011/story/source-story.md#S2E06",
  "panels": [
    {
      "panel_id": "p1-1",
      "page_number": 1,
      "scene_number": 1,
      "description": "EP010의 세 시험 카드와 청신의 수첩이 세 시설 화면 아래 놓인다. 붉은 감시점과 잠긴 안전 중단 손잡이. 글자와 숫자는 없다.",
      "camera_angle": "풀페이지 조감",
      "characters_in_frame": [],
      "visual_type": "silence",
      "text": [],
      "color_palette": "청회색·빨강"
    },
    {
      "panel_id": "p2-1",
      "page_number": 2,
      "scene_number": 2,
      "description": "단정한 검은 머리와 큰 뿔테 안경, 청회색 셔츠의 마른 왕먀오가 세 시설의 반대 보정 입력을 대조한다.",
      "camera_angle": "어깨 너머",
      "characters_in_frame": [
        "왕먀오"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "세 곳은 같은 순간에 서로 다른 보정을 넣습니다.",
          "speaker": "왕먀오"
        }
      ],
      "color_palette": "청회색"
    },
    {
      "panel_id": "p2-2",
      "page_number": 2,
      "scene_number": 2,
      "description": "옆으로 넘긴 앞머리와 어깨 아래 곧은 검은 머리, 연하늘색 블라우스와 회색 카디건의 양동이 작은 가죽 문서 가방에서 초고를 꺼낸다.",
      "camera_angle": "손에서 얼굴",
      "characters_in_frame": [
        "양동"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "어머니의 빈칸은 결과가 아니라 질문이었어요.",
          "speaker": "양동"
        }
      ],
      "color_palette": "청회색"
    },
    {
      "panel_id": "p2-3",
      "page_number": 2,
      "scene_number": 2,
      "description": "청신의 초고에는 원본 측정, 위조 보정, 재입력을 뜻하는 세 도형과 비어 있는 마지막 칸이 있다. 문자는 후처리한다.",
      "camera_angle": "수첩 극근접",
      "characters_in_frame": [
        "양동"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "caption",
          "text": "청신의 미완 실험."
        }
      ],
      "color_palette": "청회색·세피아"
    },
    {
      "panel_id": "p2-4",
      "page_number": 2,
      "scene_number": 2,
      "description": "헝클어진 검은 머리와 수염, 좁고 피곤한 눈, 낡은 올리브 재킷의 스치친이 꺼진 담배를 안전 손잡이 곁에 댄다.",
      "camera_angle": "측면 근접",
      "characters_in_frame": [
        "스치친"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "유언치곤 사용 설명서가 짧군.",
          "speaker": "스치친"
        }
      ],
      "color_palette": "청회색·올리브"
    },
    {
      "panel_id": "p3-1",
      "page_number": 3,
      "scene_number": 3,
      "description": "행성방위위원회 책임자의 얼굴은 반그림자에 잠기고 독립 제어판과 안전 차단선을 가리키는 손만 선명하다. 외형은 고정하지 않는다.",
      "camera_angle": "제어판 로우앵글",
      "characters_in_frame": [
        "PDC 실험 책임자"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "조건부 허가입니다. 중단권은 이쪽에 있습니다.",
          "speaker": "PDC 실험 책임자"
        }
      ],
      "color_palette": "청회색"
    },
    {
      "panel_id": "p3-2",
      "page_number": 3,
      "scene_number": 3,
      "description": "왕먀오가 위조 보정값을 다음 입력으로 되먹이는 고리를 투명판에 그린다. 세 화살표는 서로 반대 방향이다. 글자는 없다.",
      "camera_angle": "투명판 정면",
      "characters_in_frame": [
        "왕먀오"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "저들이 고친 값을 다음 질문으로 되돌립니다.",
          "speaker": "왕먀오"
        }
      ],
      "color_palette": "청회색·빨강"
    },
    {
      "panel_id": "p3-3",
      "page_number": 3,
      "scene_number": 3,
      "description": "양동이 초고의 빈칸에 투명 대조판을 겹쳐 원본 봉인 기록과 보정값의 출처를 분리한다.",
      "camera_angle": "손 탑숏",
      "characters_in_frame": [
        "양동"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "원본은 따로 봉인해요. 거짓 답만 다시 묻죠.",
          "speaker": "양동"
        }
      ],
      "color_palette": "청회색·세피아"
    },
    {
      "panel_id": "p3-4",
      "page_number": 3,
      "scene_number": 3,
      "description": "붉은 톱니 파형과 기하학 감시 토템이 화살표 교차점에 맺힌다. 소페르의 인간형은 없다.",
      "camera_angle": "화면 극근접",
      "characters_in_frame": [],
      "visual_type": "impact",
      "text": [
        {
          "kind": "caption",
          "text": "한 답을 고르면 다른 두 질문과 충돌한다."
        }
      ],
      "color_palette": "청회색·빨강"
    },
    {
      "panel_id": "p4-1",
      "page_number": 4,
      "scene_number": 4,
      "description": "세 시설의 연구원들이 각기 반대 방향으로 장치 다이얼을 맞춘다. 세 공간의 푸른 회색 그림자가 병치된다.",
      "camera_angle": "삼분할 와이드",
      "characters_in_frame": [
        "연구원"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "caption",
          "text": "세 시설. 한 시각. 서로 모순된 입력."
        }
      ],
      "color_palette": "청회색"
    },
    {
      "panel_id": "p4-2",
      "page_number": 4,
      "scene_number": 4,
      "description": "왕먀오의 안경에 원본 봉인 기록과 붉은 위조 파형이 나란히 비친다. 아직 일치하지 않는다.",
      "camera_angle": "안경 극근접",
      "characters_in_frame": [
        "왕먀오"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "보정이 자기 자신을 설명해야 하는 순간이 옵니다.",
          "speaker": "왕먀오"
        }
      ],
      "color_palette": "청회색·빨강"
    },
    {
      "panel_id": "p4-3",
      "page_number": 4,
      "scene_number": 4,
      "description": "스치친이 독립 제어판 앞에서 책임자의 손과 안전 차단선 사이를 확인한다. 담배는 꺼져 있다.",
      "camera_angle": "측면 이인물",
      "characters_in_frame": [
        "스치친",
        "PDC 실험 책임자"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "위험하면 즉시 끊죠.",
          "speaker": "스치친"
        }
      ],
      "color_palette": "청회색·올리브"
    },
    {
      "panel_id": "p4-4",
      "page_number": 4,
      "scene_number": 4,
      "description": "양동이 가죽 가방을 닫고 세 시설 화면 사이의 빈 검은 칸을 본다.",
      "camera_angle": "정면 중경",
      "characters_in_frame": [
        "양동"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "우리가 얻을 건 검증할 시간이에요.",
          "speaker": "양동"
        }
      ],
      "color_palette": "청회색"
    },
    {
      "panel_id": "p5-1",
      "page_number": 5,
      "scene_number": 5,
      "description": "청신의 과거. 노년의 청신이 대조 장치 하나를 비워 두고 초고 위에서 연필을 멈춘다. 이전 에피소드 모습만 따른다.",
      "camera_angle": "세피아 측면",
      "characters_in_frame": [
        "청신"
      ],
      "visual_type": "normal",
      "text": [],
      "color_palette": "세피아"
    },
    {
      "panel_id": "p5-2",
      "page_number": 5,
      "scene_number": 5,
      "description": "현재의 양동 손이 청신의 연필 자국 위에 독립 원본 보존 장치를 놓는다.",
      "camera_angle": "손 근접",
      "characters_in_frame": [
        "양동"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "끝내 못 한 대조 실험 여기서 잇겠습니다.",
          "speaker": "양동"
        }
      ],
      "color_palette": "세피아→청회색"
    },
    {
      "panel_id": "p5-3",
      "page_number": 5,
      "scene_number": 5,
      "description": "반그림자 속 책임자의 손가락이 안전 차단 손잡이 위에 머문다. 얼굴 특징은 드러나지 않는다.",
      "camera_angle": "손 극근접",
      "characters_in_frame": [
        "PDC 실험 책임자"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "원본 기록이 끊기면 바로 중단합니다.",
          "speaker": "PDC 실험 책임자"
        }
      ],
      "color_palette": "청회색"
    },
    {
      "panel_id": "p5-4",
      "page_number": 5,
      "scene_number": 5,
      "description": "왕먀오가 세 시설의 발사 신호가 한 점으로 모이는 무문자 도식을 내려다본다.",
      "camera_angle": "탑숏 중경",
      "characters_in_frame": [
        "왕먀오"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "동시에 갑니다. 서로의 답을 기다리지 않습니다.",
          "speaker": "왕먀오"
        }
      ],
      "color_palette": "청회색·빨강"
    },
    {
      "panel_id": "p6-1",
      "page_number": 6,
      "scene_number": 6,
      "description": "세 시설의 모순된 보정 화살표가 같은 붉은 톱니 파형에 동시에 꽂힌다. 파형이 자기 꼬리를 물고 흰 균열로 갈라진다. 소페르는 글리치뿐이며 문자와 숫자는 없다.",
      "camera_angle": "풀페이지 초광각",
      "characters_in_frame": [],
      "visual_type": "silence",
      "text": [],
      "color_palette": "청회색·빨강·흰색"
    },
    {
      "panel_id": "p7-1",
      "page_number": 7,
      "scene_number": 7,
      "description": "소페르의 붉은 톱니 파형이 세 입력을 따라 복제되고 서로 맞물리지 못한다. 인간형은 없다.",
      "camera_angle": "기하학 화면 근접",
      "characters_in_frame": [],
      "visual_type": "impact",
      "text": [
        {
          "kind": "sfx",
          "text": "지직"
        }
      ],
      "color_palette": "빨강·검정"
    },
    {
      "panel_id": "p7-2",
      "page_number": 7,
      "scene_number": 7,
      "description": "왕먀오가 원본 봉인 기록과 위조 출력을 번갈아 본다. 렌즈의 붉은 반사가 끊긴다.",
      "camera_angle": "안경 극근접",
      "characters_in_frame": [
        "왕먀오"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "보정이 멈췄습니다. 원본인지 확인해야 합니다.",
          "speaker": "왕먀오"
        }
      ],
      "color_palette": "청회색·흰색"
    },
    {
      "panel_id": "p7-3",
      "page_number": 7,
      "scene_number": 7,
      "description": "책임자가 독립 제어판의 물리 차단 손잡이를 놓지 않고 원본 기록선을 살핀다.",
      "camera_angle": "손과 화면",
      "characters_in_frame": [
        "PDC 실험 책임자"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "안전선 유지. 원본 계측은 살아 있습니다.",
          "speaker": "PDC 실험 책임자"
        }
      ],
      "color_palette": "청회색"
    },
    {
      "panel_id": "p7-4",
      "page_number": 7,
      "scene_number": 7,
      "description": "양동이 떨어진 두 원본 계측기의 바늘이 같은 방향으로 움직이는 것을 본다. 눈빛은 침착하다.",
      "camera_angle": "눈에서 바늘",
      "characters_in_frame": [
        "양동"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "독립 기록 두 곳이 같습니다.",
          "speaker": "양동"
        }
      ],
      "color_palette": "청회색·흰색"
    },
    {
      "panel_id": "p8-1",
      "page_number": 8,
      "scene_number": 8,
      "description": "한 시설 화면에서 붉은 톱니가 사라지고 불규칙하지만 이어지는 흰 입자 궤적이 드러난다. 수치는 후처리한다.",
      "camera_angle": "계측 화면 정면",
      "characters_in_frame": [],
      "visual_type": "impact",
      "text": [
        {
          "kind": "caption",
          "text": "첫 번째 원본 신호."
        }
      ],
      "color_palette": "청회색→흰색"
    },
    {
      "panel_id": "p8-2",
      "page_number": 8,
      "scene_number": 8,
      "description": "다른 시설의 연구원이 종이 기록과 독립 기록 장치를 맞대고 같은 불규칙성을 확인한다.",
      "camera_angle": "연구원 어깨 너머",
      "characters_in_frame": [
        "연구원"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "예측값이 아니에요. 종이에도 있습니다.",
          "speaker": "연구원"
        }
      ],
      "color_palette": "청회색·흰색"
    },
    {
      "panel_id": "p8-3",
      "page_number": 8,
      "scene_number": 8,
      "description": "세 번째 시설의 봉인 장치와 실시간 기록계가 각각 같은 궤적을 남긴다. 붉은 감시 토템은 밀려난다.",
      "camera_angle": "두 기록계 탑숏",
      "characters_in_frame": [],
      "visual_type": "impact",
      "text": [
        {
          "kind": "caption",
          "text": "서로 독립된 기록이 일치한다."
        }
      ],
      "color_palette": "청회색·흰색"
    },
    {
      "panel_id": "p8-4",
      "page_number": 8,
      "scene_number": 8,
      "description": "왕먀오가 손을 멈추고 처음 보는 불규칙한 궤적을 읽는다. 안경에는 흰색만 비친다.",
      "camera_angle": "정면 얼굴 근접",
      "characters_in_frame": [
        "왕먀오"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "진짜입니다.",
          "speaker": "왕먀오"
        }
      ],
      "color_palette": "순백·청회색"
    },
    {
      "panel_id": "p9-1",
      "page_number": 9,
      "scene_number": 9,
      "description": "지구 지도 위 여러 대륙의 가속기 화면이 동시에 흰 궤적을 밝힌다. 시설명은 후처리한다.",
      "camera_angle": "지구 조감 와이드",
      "characters_in_frame": [],
      "visual_type": "impact",
      "text": [
        {
          "kind": "caption",
          "text": "지구의 모든 가속기가 원본 데이터를 출력한다."
        }
      ],
      "color_palette": "순백·청회색"
    },
    {
      "panel_id": "p9-2",
      "page_number": 9,
      "scene_number": 9,
      "description": "스치친이 세계 연결 화면을 보고 마른 웃음만 짓는다. 꺼진 담배가 손에 있다.",
      "camera_angle": "반측면 근접",
      "characters_in_frame": [
        "스치친"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "text": "저놈들도 지금 야근 중이겠군.",
          "speaker": "스치친"
        }
      ],
      "color_palette": "청회색·올리브"
    },
    {
      "panel_id": "p9-3",
      "page_number": 9,
      "scene_number": 9,
      "description": "양동이 청신의 수첩 옆 빈 종이에 시작 시각을 적는다. 글씨는 이미지에 그리지 않는다.",
