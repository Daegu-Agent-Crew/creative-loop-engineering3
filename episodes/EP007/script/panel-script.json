{
  "episode_id": "EP007",
  "version": 1,
  "source": "episodes/EP007/script/script.md",
  "panels": [
    {
      "panel_id": "p1-1",
      "page_number": 1,
      "scene_number": 1,
      "description": "EP006 노트의 빈 제출처가 적힌 봉투가 PDC 회의장 중앙에 놓인다. 뒤의 여섯 관제 화면은 검은 천으로 가려져 있다.",
      "text": []
    },
    {
      "panel_id": "p2-1",
      "page_number": 2,
      "scene_number": 2,
      "description": "검증위원의 손이 봉투를 연다. 노트의 여섯 지문 그림만 보인다.",
      "text": []
    },
    {
      "panel_id": "p2-2",
      "page_number": 2,
      "scene_number": 2,
      "description": "검증위원이 보고서 위에 오염 표시 도장을 내려놓는다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "검증위원",
          "text": "오염된 데이터로 무슨 물리학을 합니까."
        }
      ]
    },
    {
      "panel_id": "p2-3",
      "page_number": 2,
      "scene_number": 2,
      "description": "왕머여가 뿔테를 고쳐 쓰며 반박하려다 입을 다문다.",
      "text": []
    },
    {
      "panel_id": "p2-4",
      "page_number": 2,
      "scene_number": 2,
      "description": "스치친이 손가락의 꺼진 담배를 돌리고 여섯 가린 화면을 본다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "거짓말도 입을 맞추려면 시간이 걸려."
        }
      ]
    },
    {
      "panel_id": "p3-1",
      "page_number": 3,
      "scene_number": 3,
      "description": "왕머여가 위조 출력 그래프를 뒤집어 뒷면의 빈 시간축을 드러낸다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "그 값은 믿지 않습니다."
        }
      ]
    },
    {
      "panel_id": "p3-2",
      "page_number": 3,
      "scene_number": 3,
      "description": "파란 입력선과 빨간 출력선이 분리된 투명 슬라이드를 나란히 놓는다.",
      "text": []
    },
    {
      "panel_id": "p3-3",
      "page_number": 3,
      "scene_number": 3,
      "description": "왕머여가 출력선이 바뀌는 지점을 손끝으로 가리킨다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "바뀌는 순서를 보자는 겁니다."
        }
      ]
    },
    {
      "panel_id": "p3-4",
      "page_number": 3,
      "scene_number": 3,
      "description": "검증위원이 빈 실패 기준 칸을 가리키며 펜을 건넨다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "검증위원",
          "text": "먼저 틀릴 조건부터 쓰십시오."
        }
      ]
    },
    {
      "panel_id": "p4-1",
      "page_number": 4,
      "scene_number": 4,
      "description": "왕머여 펜끝이 실패 기준 칸 위에서 멈춘다.",
      "text": []
    },
    {
      "panel_id": "p4-2",
      "page_number": 4,
      "scene_number": 4,
      "description": "무교란 대조군의 평평한 파란 선과 교란군의 빈 칸을 나란히 그린다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "대조군도 따라 움직이면, 제 보고서는 찢으십시오."
        }
      ]
    },
    {
      "panel_id": "p4-3",
      "page_number": 4,
      "scene_number": 4,
      "description": "스치친이 노트 아래에 복사용 종이를 한 장 더 밀어 넣는다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "찢기 전에 사본은 남깁시다."
        }
      ]
    },
    {
      "panel_id": "p5-1",
      "page_number": 5,
      "scene_number": 5,
      "description": "왕머여가 같은 톱니 카드 여섯 장을 펼친다.",
      "text": []
    },
    {
      "panel_id": "p5-2",
      "page_number": 5,
      "scene_number": 5,
      "description": "스치친이 카드 한 장을 빼고 신발 자국처럼 비스듬히 돌린다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "도둑 잡는데 같은 신발 여섯 켤레를 깔아두진 않아."
        }
      ]
    },
    {
      "panel_id": "p5-3",
      "page_number": 5,
      "scene_number": 5,
      "description": "여섯 카드가 삼각·계단·갈고리·갈라진 선·짧은 점·톱니로 달라진다.",
      "text": []
    },
    {
      "panel_id": "p5-4",
      "page_number": 5,
      "scene_number": 5,
      "description": "왕머여가 카드 뒤에 서로 다른 시각표를 놓는다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "모양도, 시각도 나눕니다."
        }
      ]
    },
    {
      "panel_id": "p6-1",
      "page_number": 6,
      "scene_number": 6,
      "description": "서로 다른 시설의 시계를 맞추는 연구원 손들이 영상 창에 보인다.",
      "text": []
    },
    {
      "panel_id": "p6-2",
      "page_number": 6,
      "scene_number": 6,
      "description": "왕머여가 한 장비의 교란 스위치에 투명 덮개를 씌운다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "대조 장비엔 손대지 마세요."
        }
      ]
    },
    {
      "panel_id": "p6-3",
      "page_number": 6,
      "scene_number": 6,
      "description": "스치친이 입력 카드 봉투를 봉인하고 자신의 손도 화면 밖으로 뺀다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "이쪽 봉투는 내 손이 더러워도 안 열지."
        }
      ]
    },
    {
      "panel_id": "p6-4",
      "page_number": 6,
      "scene_number": 6,
      "description": "검증위원이 봉투와 대조군을 확인하고 서명 칸에 펜을 댄다.",
      "text": []
    },
    {
      "panel_id": "p7-1",
      "page_number": 7,
      "scene_number": 7,
      "description": "검증위원이 한 손가락을 들어 단 한 차례 시험을 허락한다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "검증위원",
          "text": "한 번입니다."
        }
      ]
    },
    {
      "panel_id": "p7-2",
      "page_number": 7,
      "scene_number": 7,
      "description": "왕머여가 여섯 입력 키의 서로 다른 모양을 확인한다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "한 번이면 순서는 볼 수 있습니다."
        }
      ]
    },
    {
      "panel_id": "p7-3",
      "page_number": 7,
      "scene_number": 7,
      "description": "여섯 손가락이 시설마다 다른 키 위에서 각자의 예정 시각을 기다린다.",
      "text": []
    },
    {
      "panel_id": "p7-4",
      "page_number": 7,
      "scene_number": 7,
      "description": "첫 키가 눌리고 파란 입력선 하나가 꺾인다. 빨간 출력선은 아직 그대로다.",
      "text": []
    },
    {
      "panel_id": "p8-1",
      "page_number": 8,
      "scene_number": 8,
      "description": "텅 빈 관제실의 여섯 모니터에 가느다란 정지선. 아래 구석의 두 사람은 아주 작다.",
      "text": []
    },
    {
      "panel_id": "p9-1",
      "page_number": 9,
      "scene_number": 9,
      "description": "한 시설의 빨간 출력선에 작은 흔들림이 나타난다.",
      "text": []
    },
    {
      "panel_id": "p9-2",
      "page_number": 9,
      "scene_number": 9,
      "description": "빨간 선의 흔들림이 급속히 줄어 매끈한 선으로 돌아간다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "검증위원",
          "text": "돌아왔군요. 원래대로."
        }
      ]
    },
    {
      "panel_id": "p9-3",
      "page_number": 9,
      "scene_number": 9,
      "description": "왕머여가 다른 화면으로 눈을 옮긴다. 화면마다 복구 시작점이 다르다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "너무 빨리요."
        }
      ]
    },
    {
      "panel_id": "p10-1",
      "page_number": 10,
      "scene_number": 10,
      "description": "왕머여가 여섯 화면의 복구 구간을 투명 종이 띠로 떠 나란히 펼친다.",
      "text": []
    },
    {
      "panel_id": "p10-2",
      "page_number": 10,
      "scene_number": 10,
      "description": "계단 입력 뒤엔 계단 모양 보정, 갈고리 뒤엔 갈고리 모양 보정이 다른 시차로 나타난다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "계단은 계단 뒤에, 갈고리는 갈고리 뒤에 바뀌었습니다."
        }
      ]
    },
    {
      "panel_id": "p10-3",
      "page_number": 10,
      "scene_number": 10,
      "description": "다른 네 지문도 각각 자기 모양을 따라가며 붉은 출력 폭이 좁아진다.",
      "text": []
    },
    {
      "panel_id": "p10-4",
      "page_number": 10,
      "scene_number": 10,
      "description": "스치친이 사용한 카드와 복구 띠를 나란히 둔다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "발자국을 지우면서 새 발자국을 찍었네."
        }
      ]
    },
    {
      "panel_id": "p11-1",
      "page_number": 11,
      "scene_number": 11,
      "description": "검증위원이 여섯 화면 뒤에 공통 장비 계통도를 세운다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "검증위원",
          "text": "같은 계통의 장비라면?"
        }
      ]
    },
    {
      "panel_id": "p11-2",
      "page_number": 11,
      "scene_number": 11,
      "description": "왕머여가 쓰려던 결론의 첫 줄을 펜으로 가로 긋는다.",
      "text": []
    },
    {
      "panel_id": "p11-3",
      "page_number": 11,
      "scene_number": 11,
      "description": "스치친이 봉인된 무교란 대조 봉투를 위원 앞에 놓는다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "그래서 손대지 않은 선이 있습니다."
        }
      ]
    },
    {
      "panel_id": "p11-4",
      "page_number": 11,
      "scene_number": 11,
      "description": "세 사람이 봉투를 내려다보며 누구도 먼저 손대지 않는다.",
      "text": []
    },
    {
      "panel_id": "p12-1",
      "page_number": 12,
      "scene_number": 12,
      "description": "검증위원이 봉인을 열고 대조군의 평평한 선을 여섯 변화 옆에 놓는다.",
      "text": []
    },
    {
      "panel_id": "p12-2",
      "page_number": 12,
      "scene_number": 12,
      "description": "왕머여가 각 시설의 입력 시각과 출력 변화 시각을 서로 다른 투명자로 잰다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "입력 전엔 없고, 대조에는 없습니다."
        }
      ]
    },
    {
      "panel_id": "p12-3",
      "page_number": 12,
      "scene_number": 12,
      "description": "검증위원이 대조선과 오염 출력선을 번갈아 본다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "검증위원",
          "text": "그럼 이건 물리학의 값이 아니군요."
        }
      ]
    },
    {
      "panel_id": "p13-1",
      "page_number": 13,
      "scene_number": 13,
      "description": "여섯 모니터의 서로 다른 지문이 각기 다른 박자로 교란 뒤를 따라 좁아진다. 평평한 대조선은 중앙을 가른다.",
      "text": []
    },
    {
      "panel_id": "p14-1",
      "page_number": 14,
      "scene_number": 14,
      "description": "왕머여가 위원의 물음 앞에 펼친 손을 책상에 얹는다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "거짓말의 반응 시간입니다."
        }
      ]
    },
    {
      "panel_id": "p14-2",
      "page_number": 14,
      "scene_number": 14,
      "description": "검증위원이 보고서의 승인 칸을 비워 두고 다음 시험 칸을 가리킨다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "검증위원",
          "text": "한 번으로는 결재할 수 없습니다."
        }
      ]
    },
    {
      "panel_id": "p14-3",
      "page_number": 14,
      "scene_number": 14,
      "description": "스치친이 두 번째 빈 봉투를 꺼내 왕머여 옆에 놓는다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "그럼 두 번째 신발을 놓죠."
        }
      ]
    },
    {
      "panel_id": "p14-4",
      "page_number": 14,
      "scene_number": 14,
      "description": "왕머여가 보고서에 제한된 한 줄을 쓰고 아래를 길게 비운다.",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "감시자는 입력마다 보정했습니다. 내부는 아직 모릅니다."
        }
      ]
    },
    {
      "panel_id": "p15-1",
      "page_number": 15,
      "scene_number": 15,
      "description": "p1에서 가려졌던 여섯 화면이 열린다. 지문과 후행 보정선이 배열돼 멀리서 하나의 눈 윤곽처럼 보인다. 두 사람은 작은 뒷모습.",
      "text": []
    }
  ]
}
