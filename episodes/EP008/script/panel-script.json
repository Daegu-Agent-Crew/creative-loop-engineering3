{
  "episode_id": "EP008",
  "version": 1,
  "source": "episodes/EP008/script/script.md",
  "panels": [
    {
      "panel_id": "p1-1",
      "page_number": 1,
      "scene_number": 1,
      "description": "삼체 관측실에서 홀로 앉은 1379호 앞에 지구 송신의 작은 파형 흠이 관측 모형 여러 층으로 번진다 연출: 무대사·무자막 풀페이지. 인간형으로 단정하지 않는 뒷모습 실루엣. 흠의 톱니 하나를 선명히",
      "camera_angle": "풀페이지 후면 초광각",
      "characters_in_frame": [
        "1379호"
      ],
      "visual_type": "silence",
      "text": [],
      "color_palette": "세피아·먹색·신호 빨강"
    },
    {
      "panel_id": "p2-1",
      "page_number": 2,
      "scene_number": 2,
      "description": "EP007의 여섯 화면 뒤편에서 왕머여가 지연이 다른 붉은 출력선들을 투명지에 겹친다 연출: 단정한 검은 머리·큰 뿔테 안경·청회색 셔츠·마른 체형. 렌즈에 미세 톱니",
      "camera_angle": "오버숄더 중경",
      "characters_in_frame": [
        "왕머여"
      ],
      "visual_type": "normal",
      "text": [],
      "color_palette": "청회색·신호 빨강"
    },
    {
      "panel_id": "p2-2",
      "page_number": 2,
      "scene_number": 2,
      "description": "스치친이 재떨이를 밀고 여섯 선의 같은 흠을 손톱으로 짚는다 연출: 헝클어진 검은 머리·수염·좁은 피곤한 눈·낡은 올리브 재킷·담배",
      "camera_angle": "손·얼굴 측면",
      "characters_in_frame": [
        "스치친"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "여섯 놈이 같은 데서 넘어졌네."
        }
      ],
      "color_palette": "올리브·청회색"
    },
    {
      "panel_id": "p2-3",
      "page_number": 2,
      "scene_number": 2,
      "description": "왕머여가 다른 시설 원자료와 비교해 흠이 출력 보정 뒤에만 남음을 확인한다 연출: 입술을 다물고 한 선씩 분리. 화면 글자와 숫자는 비운다",
      "camera_angle": "투명지 탑숏",
      "characters_in_frame": [
        "왕머여"
      ],
      "visual_type": "impact",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "같은 입력이 아닙니다. 같은 보정 흔적입니다."
        }
      ],
      "color_palette": "흰색·청색·빨강"
    },
    {
      "panel_id": "p2-4",
      "page_number": 2,
      "scene_number": 2,
      "description": "관제실 문틈 아래로 낡은 봉투 사진이 미끄러져 들어온다 연출: 뒷면은 비워 두고 세 갈래 봉인 흠집만 보인다",
      "camera_angle": "바닥 낮은 앵글",
      "characters_in_frame": [],
      "visual_type": "normal",
      "text": [],
      "color_palette": "청회색·세피아"
    },
    {
      "panel_id": "p3-1",
      "page_number": 3,
      "scene_number": 3,
      "description": "스치친이 복도 카메라 사각에서 사진을 집고 양쪽 문을 살핀다 연출: 담배는 입에 물었지만 불은 붙이지 않는다",
      "camera_angle": "복도 롱숏",
      "characters_in_frame": [
        "스치친"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "우편배달부가 수줍음이 많군."
        }
      ],
      "color_palette": "청회색·검정"
    },
    {
      "panel_id": "p3-2",
      "page_number": 3,
      "scene_number": 3,
      "description": "사진 속 보관함 손잡이와 1379호의 경고 번역 일부가 겹친다 연출: 문장은 이미지에 그리지 않고 후처리 여백. 손잡이 세 갈래 흠집",
      "camera_angle": "사진 매크로",
      "characters_in_frame": [],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "“응답하지 마라.” 그 문장만 남았습니다."
        }
      ],
      "color_palette": "세피아·검정"
    },
    {
      "panel_id": "p3-3",
      "page_number": 3,
      "scene_number": 3,
      "description": "왕머여가 사진 뒷면 파형을 현재 여섯 출력의 공통 흠 위에 얹는다 연출: 두 파형은 완전 일치가 아니라 결함 위치만 닮았다",
      "camera_angle": "손·렌즈 극근접",
      "characters_in_frame": [
        "왕머여"
      ],
      "visual_type": "impact",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "원본을 봐야 합니다. 닮았다는 이유만으론 부족합니다."
        }
      ],
      "color_palette": "세피아·빨강"
    },
    {
      "panel_id": "p3-4",
      "page_number": 3,
      "scene_number": 3,
      "description": "스치친이 손잡이 흠집과 건물 평면도의 폐쇄 보관실 표시를 맞춘다 연출: 평면도 글자를 비우고 흠집 모양만 반복",
      "camera_angle": "평면도 탑숏",
      "characters_in_frame": [
        "스치친"
      ],
      "visual_type": "normal",
      "text": [],
      "color_palette": "올리브·흰색"
    },
    {
      "panel_id": "p4-1",
      "page_number": 4,
      "scene_number": 4,
      "description": "폐쇄 보관실 앞에서 스치친이 봉인 위 새 접착 흔적을 찾는다 연출: 오래된 먼지 위 새 광택. 잠금장치 파손 없음",
      "camera_angle": "문손잡이 근접",
      "characters_in_frame": [
        "스치친"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "오래 닫힌 문치곤 손때가 새 거야."
        }
      ],
      "color_palette": "청회색·호박색"
    },
    {
      "panel_id": "p4-2",
      "page_number": 4,
      "scene_number": 4,
      "description": "왕머여가 1967년 장비 기록 상자와 편지 보관 상자를 나란히 본다 연출: 연도와 표제는 후처리. 안경 반사는 차갑게",
      "camera_angle": "이인물 중경",
      "characters_in_frame": [
        "왕머여",
        "스치친"
      ],
      "visual_type": "normal",
      "text": [],
      "color_palette": "청회색·세피아"
    },
    {
      "panel_id": "p4-3",
      "page_number": 4,
      "scene_number": 4,
      "description": "보관함 안 문서 뭉치의 가운데 한 묶음만 빠져 있다 연출: 종이 단면의 빈 사각형과 새 긁힘을 크게",
      "camera_angle": "보관함 정면",
      "characters_in_frame": [
        "스치친"
      ],
      "visual_type": "impact",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "누군가 결론만 훔쳐 갔군."
        }
      ],
      "color_palette": "먹색·세피아"
    },
    {
      "panel_id": "p4-4",
      "page_number": 4,
      "scene_number": 4,
      "description": "왕머여가 남은 교정표 복사 눌림을 사선 빛으로 읽는다 연출: 글자를 비우고 기준선 한 칸 어긋남만 표시",
      "camera_angle": "종이 사선 매크로",
      "characters_in_frame": [
        "왕머여"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "결론은 없어도 기준선은 남았습니다."
        }
      ],
      "color_palette": "세피아·흰색"
    },
    {
      "panel_id": "p5-1",
      "page_number": 5,
      "scene_number": 5,
      "description": "1967년 홍안 교정실에서 낡은 측정기가 두 참조점을 같은 눈금처럼 표시한다 연출: 플래시백의 따뜻한 세피아와 붉은 장비등. 문자와 숫자 없음",
      "camera_angle": "기기 정면 중경",
      "characters_in_frame": [],
      "visual_type": "normal",
      "text": [],
      "color_palette": "세피아·붉은 등"
    },
    {
      "panel_id": "p5-2",
      "page_number": 5,
      "scene_number": 5,
      "description": "기술자의 손이 교정표 기준 칸을 한 칸 밀린 곳에 복사한다 연출: 악의 없는 반복 작업. 얼굴은 숨기고 펜촉과 압흔만",
      "camera_angle": "손 극근접",
      "characters_in_frame": [
        "홍안 기술자"
      ],
      "visual_type": "normal",
      "text": [],
      "color_palette": "세피아·먹색"
    },
    {
      "panel_id": "p5-3",
      "page_number": 5,
      "scene_number": 5,
      "description": "서로 다른 두 실측 파형이 교정표를 통과하며 같은 미세 톱니를 얻는다 연출: 물리 현상이 아닌 기록 변환의 오류. 입력과 출력 색을 구분",
      "camera_angle": "도식 탑숏",
      "characters_in_frame": [],
      "visual_type": "impact",
      "text": [],
      "color_palette": "세피아·청색·빨강"
    },
    {
      "panel_id": "p5-4",
      "page_number": 5,
      "scene_number": 5,
      "description": "현재 왕머여가 압흔과 여섯 출력의 흠 위치를 맞춘다 연출: 세피아 종이와 차가운 현재 화면이 맞닿는다",
      "camera_angle": "손·화면 오버숄더",
      "characters_in_frame": [
        "왕머여"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "왕머여",
          "text": "측정값이 아니라 변환 기준의 오차입니다."
        }
      ],
      "color_palette": "세피아·청회색"
    },
    {
      "panel_id": "p6-1",
      "page_number": 6,
      "scene_number": 6,
      "description": "홍안 송신 준비실에 신호 원고와 지구 관측 자료 도판이 함께 쌓인다 연출: 플래시백. 인코딩 방식은 확정하지 않는다. 글자 여백",
      "camera_angle": "자료 더미 광각",
      "characters_in_frame": [],
      "visual_type": "normal",
      "text": [],
      "color_palette": "세피아·호박색"
    },
    {
      "panel_id": "p6-2",
      "page_number": 6,
      "scene_number": 6,
      "description": "기술자가 잘못 복사된 교정표를 도판 묶음에 끼워 넣는다 연출: 한 장의 모서리가 삐져나와 자료 동봉의 인과를 드러낸다",
      "camera_angle": "손 인서트",
      "characters_in_frame": [
        "홍안 기술자"
      ],
      "visual_type": "impact",
      "text": [],
      "color_palette": "세피아·먹색"
    },
    {
      "panel_id": "p6-3",
      "page_number": 6,
      "scene_number": 6,
      "description": "홍안 안테나가 밤하늘을 향하고 도판의 미세 톱니가 추상 파형으로 이어진다 연출: 텍스트 없는 신호 메타포. 도착 과정은 생략",
      "camera_angle": "안테나 낮은 앵글",
      "characters_in_frame": [],
      "visual_type": "normal",
      "text": [],
      "color_palette": "세피아·빨강"
    },
    {
      "panel_id": "p6-4",
      "page_number": 6,
      "scene_number": 6,
      "description": "현재 스치친이 종이 모서리와 송신 목록 압흔을 맞춘다 연출: 담배를 쥔 손이 멈춘다. 목록 글자는 후처리",
      "camera_angle": "손·얼굴 중경",
      "characters_in_frame": [
        "스치친"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "스치친",
          "text": "편지에 딸린 사고 보고서였나 보군."
        }
      ],
      "color_palette": "올리브·세피아"
    },
    {
      "panel_id": "p7-1",
      "page_number": 7,
      "scene_number": 7,
      "description": "지구에서 떠난 가느다란 신호 파형이 검은 우주를 건너 삼체 관측 모형 격자에 들어가고 미세 톱니가 여러 층으로 복제된다 연출: 무대사·무자막 풀페이지. 시간과 정보 흐름의 압축 도식. 우주 물리 자체가 변한 듯 그리지 않는다",
      "camera_angle": "풀페이지 우주 초광각",
      "characters_in_frame": [],
      "visual_type": "silence",
      "text": [],
      "color_palette": "세피아·먹색·빨강"
    },
    {
      "panel_id": "p8-1",
      "page_number": 8,
      "scene_number": 8,
      "description": "1379호가 지구 자료 적용 전후의 관측 예측을 두 투명 격자로 비교한다 연출: 한쪽에만 톱니가 반복. 실루엣 유지",
      "camera_angle": "격자 오버숄더",
      "characters_in_frame": [
        "1379호"
      ],
      "visual_type": "normal",
      "text": [],
      "color_palette": "세피아·먹색"
    },
    {
      "panel_id": "p8-2",
      "page_number": 8,
      "scene_number": 8,
      "description": "1379호가 오염된 층을 분리하자 예측의 한 갈래가 다시 벌어진다 연출: 모형 입력의 문제라는 시각적 증거. 손은 장갑 같은 추상 실루엣",
      "camera_angle": "손·격자 극근접",
      "characters_in_frame": [
        "1379호"
      ],
      "visual_type": "impact",
      "text": [],
      "color_palette": "세피아·빨강"
    },
    {
      "panel_id": "p8-3",
      "page_number": 8,
      "scene_number": 8,
      "description": "다른 감시자들이 더 매끈한 격자를 채택하는 사이 1379호만 손을 거둔다 연출: 집단과 단독의 거리. 얼굴 없음",
      "camera_angle": "관측실 광각",
      "characters_in_frame": [
        "1379호",
        "감시자들"
      ],
      "visual_type": "normal",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "1379호",
          "text": "이 신호를 기준으로 삼으면 우리도 틀린다."
        }
      ],
      "color_palette": "세피아·검정"
    },
    {
      "panel_id": "p8-4",
      "page_number": 8,
      "scene_number": 8,
      "description": "1379호가 지구 응답 회로 앞에서 손을 멈춘다 연출: 인류에 대한 연민과 오염 회피를 함께 열어 둔다",
      "camera_angle": "회로 측면 근접",
      "characters_in_frame": [
        "1379호"
      ],
      "visual_type": "silence",
      "text": [],
      "color_palette": "세피아·붉은 등"
    },
    {
      "panel_id": "p9-1",
      "page_number": 9,
      "scene_number": 9,
      "description": "1379호가 경고 신호를 쓰며 지구 송신 파형의 톱니를 별도 진단 도식으로 붙인다 연출: 문자와 기호는 후처리. 결함 도식이 진의의 증거",
      "camera_angle": "탁상 탑숏",
      "characters_in_frame": [
        "1379호"
      ],
      "visual_type": "impact",
      "text": [
        {
          "kind": "dialogue",
          "speaker": "1379호",
          "text": "응답하지 마라."
        }
      ],
      "color_palette": "세피아·먹색"
    },
    {
      "panel_id": "p9-2",
      "page_number": 9,
      "scene_number": 9,
      "description": "그가 경고와 진단 도식을 갈라 보내자 진단 쪽 송신등이 잠깐 약해진다 연출: 두 조각이 다른 경로를 지나는 씨앗. 통신 세부는 보류",
      "camera_angle": "회로 인서트",
      "characters_in_frame": [
        "1379호"
      ],
      "visual_type": "normal",
      "text": [],
      "color_palette": "세피아·빨강"
    },
    {
      "panel_id": "p9-3",
